# Ignore every top-level directory by default. This workspace contains many
# independent Project Zomboid mod repos, and the parent repo must not absorb them.
/*/

# Track project-local Codex instructions and skills.
!/.codex/
/.codex/*
!/.codex/instructions/
!/.codex/instructions/**
!/.codex/skills/
!/.codex/skills/**

# Track reusable workspace helpers, but keep local binaries and generated output ignored.
!/.tools/
/.tools/*
!/.tools/decompile-pz.sh
!/.tools/pz-b4220-tiledef-convert.py
!/.tools/pz-map-cell-ledger.sh
!/.tools/pz-map-shadow-audit.sh
!/.tools/pz-continue-debug.sh

# Ignore generated Python bytecode inside explicitly tracked instruction/tool trees.
**/__pycache__/
*.py[cod]
